{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Magic Island Website (Dev)",
      "type": "shell",
      "command": "node scripts/start.js",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Magic Island",
          "endsPattern": "Ready in|Local:|Ready at"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Full Stack (Frontend + Laravel Backend)",
      "type": "shell",
      "command": "node scripts/start-all.js",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Complete Project Setup",
      "type": "shell",
      "command": "node scripts/setup.js",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
