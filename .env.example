# ==============================================================================
# MAGIC ISLAND THEME PARK - ENVIRONMENT CONFIGURATION (SAMPLE / PLACEHOLDER)
# ==============================================================================
# Copy this file to .env.local and populate with your verified credentials.
# NEVER commit real production secret keys or credentials to version control.

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Official Park Helpdesk (E.164 format without +, e.g., 8801700000000)
# Default is set to placeholder. When empty or containing X, WhatsApp booking gracefully indicates unconfigured state.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX

# Centralized Business Location Placeholders (Overridable via ENV)
NEXT_PUBLIC_PARK_LOCATION_NAME="[Location Pending Official Announcement, Bangladesh]"
NEXT_PUBLIC_PARK_ADDRESS="[Park Physical Address - Currently Under Development / To Be Announced]"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""
NEXT_PUBLIC_PARK_LATITUDE=""
NEXT_PUBLIC_PARK_LONGITUDE=""

# Payment Gateway Configuration
# Mode: "sandbox" (for local testing/demonstration) or "production"
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_GATEWAY_PROVIDER=sslcommerz # Options: sslcommerz | bkash | mock

# SSLCommerz Configuration (Placeholders)
SSLCOMMERZ_STORE_ID=magic_island_sandbox_id
SSLCOMMERZ_STORE_PASSWORD=magic_island_sandbox_secret
SSLCOMMERZ_IS_LIVE=false

# bKash Checkout Configuration (Placeholders)
BKASH_APP_KEY=your_bkash_app_key_placeholder
BKASH_APP_SECRET=your_bkash_app_secret_placeholder
BKASH_USERNAME=your_bkash_username_placeholder
BKASH_PASSWORD=your_bkash_password_placeholder
BKASH_IS_LIVE=false

# Internal Webhook / IPN Signature Secret
PAYMENT_WEBHOOK_SECRET=your_secure_webhook_secret_here

